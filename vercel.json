{
  "installCommand": "npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sitegrade-backend.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://sitegrade-backend.onrender.com/api/auth/$1"
    },
    {
      "source": "/screenshots/(.*)",
      "destination": "https://sitegrade-backend.onrender.com/screenshots/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
