PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173
# Production frontend example:
# CLIENT_URL=https://site-grade-6lyx.vercel.app
PUPPETEER_CACHE_DIR=./.cache/puppeteer
PUPPETEER_REUSE_BROWSER=true
PUPPETEER_POST_LOAD_DELAY_MS=1000
ANALYSIS_CAPTURE_SCREENSHOTS=true
ANALYSIS_FETCH_TIMEOUT_MS=8000
CRUX_API_KEY=

MONGODB_URI=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

GEMINI_API_KEY=
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
SCREENSHOTS_DIR=./screenshots
RUN_ANALYSIS_WORKER_IN_API=false
RUN_SCHEDULE_WORKER_IN_API=true
SCHEDULE_WORKER_POLL_MS=60000
ANALYSIS_WORKER_CONCURRENCY=2
ANALYSIS_WORKER_RATE_LIMIT_MAX=5
ANALYSIS_WORKER_RATE_LIMIT_DURATION_MS=60000
ANALYSIS_QUEUE_ATTEMPTS=3
ANALYSIS_QUEUE_BACKOFF_MS=1000
ANALYSIS_QUEUE_REMOVE_COMPLETE_COUNT=1000
ANALYSIS_QUEUE_REMOVE_COMPLETE_AGE_SEC=86400
ANALYSIS_QUEUE_REMOVE_FAIL_COUNT=5000
ANALYSIS_QUEUE_REMOVE_FAIL_AGE_SEC=604800
LIST_REPORTS_CACHE_TTL_SECONDS=60
DASHBOARD_INSIGHTS_CACHE_TTL_SECONDS=120

# Upstash / production Redis URL example:
# rediss://default:<password>@<database>.upstash.io:6379
REDIS_URL=
